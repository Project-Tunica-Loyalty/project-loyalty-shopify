# Shopify CLI supplies app URL, API key, secret and scopes during app dev.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,read_customers,read_products,read_discounts,write_discounts,write_app_proxy

# Use a separate PostgreSQL schema for Shopify and brand-admin sessions.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/reglrs_2?schema=shopify_sessions
LOYALTY_BACKEND_URL=http://127.0.0.1:4002/api
# Generate 32 random bytes as hex; use the SAME value in backend .env.
SHOPIFY_LOYALTY_SERVICE_SECRET=
# Generate a DIFFERENT 32-byte hex key. Encrypts server-side brand sessions/exports.
LOYALTY_ADMIN_SESSION_KEY=
