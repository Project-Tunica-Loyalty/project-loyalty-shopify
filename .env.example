# For Docker Compose, copy this file to .env and set all values below.
# Shopify CLI supplies app URL, API key, secret and scopes during app dev.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://loyalty.example.com
# Leave SHOP_CUSTOM_DOMAIN unset for normal myshopify.com authentication.
# It is unrelated to the public app hostname above.
SCOPES=read_orders,read_customers,read_products,read_discounts,write_discounts,write_app_proxy

# For local `shopify app dev`, point this at an existing PostgreSQL database.
# Docker Compose overrides DATABASE_URL for the app container and creates its own database.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/reglrs_2?schema=shopify_sessions
# Use a long URL-safe password (letters, numbers, hyphens, underscores) for Compose.
POSTGRES_PASSWORD=
# Optional host port behind your HTTPS reverse proxy.
APP_PORT=3000
# Existing Project Loyalty backend; reachable from inside the app container.
# A host-loopback address such as 127.0.0.1 will not reach the Docker host.
LOYALTY_BACKEND_URL=https://backend.example.com/api
# Generate 32 random bytes as hex; use the SAME value in backend .env.
SHOPIFY_LOYALTY_SERVICE_SECRET=
# Generate a DIFFERENT 32-byte hex key. Encrypts server-side brand sessions/exports.
LOYALTY_ADMIN_SESSION_KEY=
