{% assign show_redeem = false %}
{% if request.page_type == 'cart' %}
  {% assign show_redeem = true %}
{% endif %}
{% render 'loyalty-ui', heading: block.settings.heading, show_redeem: show_redeem %}
{% schema %}
{
  "name": "Project Loyalty",
  "target": "section",
  "javascript": "loyalty.js",
  "stylesheet": "loyalty.css",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your loyalty points" }
  ]
}
{% endschema %}
