meta {
  name: Acknowledge deactivated discount
  type: http
  seq: 15
}
post {
  url: {{base_url}}/integrations/shopify/discounts/deactivated
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  x-loyalty-timestamp: {{shopify_service_timestamp}}
  x-loyalty-signature: {{shopify_service_signature}}
}
body:json {
  {
    "shopId": "{{shopify_shop_id}}",
    "discountId": "{{shopify_discount_id}}"
  }
}
tests {
  test('Expected response', () => { expect(res.getStatus()).to.equal(201);  });
}
docs {
  Server-to-server HMAC only. Sign the expanded request path including /api and query string, timestamp, uppercase method and EXACT body bytes separated by newlines. See docs/integrations/shopify-loyalty.md. Never put this signing secret in storefront JavaScript. Shop-scoped acknowledgement only after successful Shopify deactivation.
}
