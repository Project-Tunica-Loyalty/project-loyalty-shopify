meta {
  name: Signup verify OTP
  type: http
  seq: 12
}
post {
  url: {{base_url}}/integrations/shopify/customers/signup/otp/verify
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  x-loyalty-timestamp: {{shopify_service_timestamp}}
  x-loyalty-signature: {{shopify_service_signature}}
}
body:json {
  {
    "shopId": "{{shopify_shop_id}}",
    "customerId": "{{shopify_customer_id}}",
    "challengeId": "{{shopify_signup_challenge_id}}",
    "otp": "{{consumer_otp}}"
  }
}
tests {
  test('Expected response', () => { expect(res.getStatus()).to.equal(201); expect(res.getBody().signupVerificationToken).to.be.a('string'); });
}
docs {
  Server-to-server HMAC only. Sign the expanded request path including /api and query string, timestamp, uppercase method and EXACT body bytes separated by newlines. See docs/integrations/shopify-loyalty.md. Never put this signing secret in storefront JavaScript. Copy signupVerificationToken into the secret consumer_signup_verification_token. Wrong Shopify customer must be rejected.
}
